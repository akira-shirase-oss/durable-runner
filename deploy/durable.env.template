# /etc/durable/durable.env — root-only (0600): holds the API keys.
# install.sh fills the two keys; edit the rest to taste, restart to apply.

# The write/admin key and the read-only key (D-037). install.sh generated
# these; rotate by editing and `systemctl restart durable-server`.
DURABLE_API_KEY=__API_KEY__
DURABLE_READ_KEY=__READ_KEY__

# Loopback only: Caddy is the only way in.
DURABLE_LISTEN=127.0.0.1:58300
DURABLE_JOURNAL=/var/lib/durable/journal

# Per-client bounds (D-052). Behind Cloudflare the peer is the edge, so
# the proxy gets the higher connection cap; the request rate applies to
# the real client address from CF-Connecting-IP, trusted only inside
# /etc/durable/trusted-proxies.
DURABLE_RATE_LIMIT_PER_ADDR=100
DURABLE_MAX_CONNS_PER_ADDR=64
DURABLE_MAX_CONNS_PER_PROXY=4096

# Named backups land under this root (POST /admin/backup).
DURABLE_BACKUP_ROOT=/var/lib/durable/backups
# The inspector, if you installed its build.
DURABLE_UI_DIR=/usr/local/share/durable/inspector

# One handler per line lives in /etc/durable/handlers (name=url), e.g.
#   step=http://127.0.0.1:59010/step
# Anything else: DURABLE_EXTRA_ARGS="--max-live-runs 2000000"
