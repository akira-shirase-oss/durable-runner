# Durable Runner, shared droplet (deploy/droplet)
# /etc/durable/durable.env: settings only, no secrets (those are root-only files in
# /etc/durable/credentials, see put-secret.sh). install.sh writes this once and never overwrites
# it; edit, then `systemctl restart durable-server`. Values with spaces are double-quoted:
# systemd strips the quotes, and durable-backup sources this file with bash.

# Loopback only: Caddy (/etc/caddy/sites/durable-runner.caddy) is the only way in. 58300 is
# Durable Runner's own loopback port on this shared host (Colophon uses 58000).
DURABLE_LISTEN=127.0.0.1:58300
DURABLE_JOURNAL=/var/lib/durable/journal
DURABLE_BACKUP_ROOT=/var/lib/durable/backups
# The dashboard release direct/droplet-deploy.sh switched to (a link). The server binary is
# /usr/local/bin/durable-server, durable-run's default: deploy/upgrade.sh installs it there.
DURABLE_UI_DIR=/opt/durable/dashboard

# Per-client bounds (D-052). The server sees only Caddy over loopback and trusts that hop alone
# (durable-run adds it for a loopback listener); Caddy tells it the client in CF-Connecting-IP.
# No Cloudflare ranges here: /etc/durable/trusted-proxies stays absent on this host.
DURABLE_RATE_LIMIT_PER_ADDR=100
DURABLE_MAX_CONNS_PER_ADDR=64
DURABLE_MAX_CONNS_PER_PROXY=4096

# The hosted service. Every mailed link and redirect is built from this origin, never the
# request's Host; the server refuses to start without it when an account store is configured.
# Caddy's site address and the smoke checks follow it (caddy-merge.sh, smoke.sh). It reaches the
# server as --public-origin only once the binary has that flag (S3; main's may not yet).
DURABLE_PUBLIC_ORIGIN=https://durablerunnerapp.404human.dev
# Transactional mail through Resend; the API key is the resend_api_key credential.
DURABLE_MAIL_FROM="Durable Runner <durable-runner@404human.dev>"
# Invite-only sign-up is OFF: the line stays commented. The server checks only whether the
# variable exists, so DURABLE_INVITE_ONLY=0 would turn it ON (durable-saas-run.sh reads 0, false,
# off, no or empty as off and drops the variable; 1, true, on or yes as on).
#DURABLE_INVITE_ONLY=1
# The hosted service refuses to start without the account store (database_url) or the mail key
# (resend_api_key); 0 runs it without them (a key-only server, like a self-host).
DURABLE_REQUIRE_ACCOUNTS=1
DURABLE_REQUIRE_MAIL=1

# The ops listener (--ops-listen): the env ops keys answer only here, on loopback, reached through
# an SSH tunnel; on the public listener they get 401. Required with an account store (the server
# and durable-saas-run.sh both refuse to start without it). install.sh keeps 58301 free (or ours).
DURABLE_OPS_LISTEN=127.0.0.1:58301

# Per-workspace capacity, a stopgap until plan limits (S3-4): one workspace's share of live runs
# and of the retained-run index (bytes), so one free account can't fill the host.
DURABLE_MAX_LIVE_RUNS_PER_WS=500
DURABLE_MAX_INDEX_BYTES_PER_WS=16777216

# Where the dashboard is mounted: the server serves --ui-dir at /app/ (/inspector answers 308
# there). Caddy's root redirect and the deploy's public check follow this (rerun caddy-merge.sh
# after changing it).
DURABLE_DASHBOARD_PATH=/app/

# Handlers named on the command line (workspace 0) go in /etc/durable/handlers, one name=url per
# line; tenants register theirs through the API. Addresses a handler call must never dial that
# aren't on an interface (the droplet's reserved IP) go in /etc/durable/deny-cidrs.
# Anything else: DURABLE_EXTRA_ARGS="--max-live-runs 200000"
